# AWS
AWS_PROFILE=playbookiq
AWS_REGION=us-east-1

# Bedrock model IDs — verify with `aws bedrock list-foundation-models` and
# `aws bedrock list-inference-profiles` before use. As of this build, the PRD's
# literal claude-3-5-sonnet ID is gone from the catalog, and newer Claude models
# (Sonnet 5, Haiku 4.5, etc.) require an inference profile ID (us.* / global.*),
# not a bare on-demand model ID — invoking one directly fails with:
#   ValidationException: Invocation of model ID ... with on-demand throughput
#   isn't supported. Retry your request with the ID or ARN of an inference profile.
BEDROCK_SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Bedrock Guardrails (populated in Phase 6)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Bedrock Agents (populated in Phase 7)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# Storage backend: local | s3
STORAGE_BACKEND=local
S3_BUCKET_NAME=

# Vector store backend: local | opensearch_serverless
VECTOR_STORE_BACKEND=local
OPENSEARCH_COLLECTION_ENDPOINT=
BEDROCK_KB_ID=

# FastAPI backend URL (used by the Streamlit frontend)
API_BASE_URL=http://localhost:8000
