# AWS
AWS_PROFILE=playbookiq
AWS_REGION=us-east-1

# Bedrock model IDs (verify against `aws bedrock list-foundation-models` before use —
# these may need to change to newer models/inference-profile ARNs by the time you get here)
BEDROCK_SONNET_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Bedrock Guardrails (populated in Phase 6)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Bedrock Agents (populated in Phase 7)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# Storage backend: local | s3
STORAGE_BACKEND=local
S3_BUCKET_NAME=

# Vector store backend: local | opensearch_serverless
VECTOR_STORE_BACKEND=local
OPENSEARCH_COLLECTION_ENDPOINT=
BEDROCK_KB_ID=

# FastAPI backend URL (used by the Streamlit frontend)
API_BASE_URL=http://localhost:8000
